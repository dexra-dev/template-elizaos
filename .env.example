# Copy to .env and fill in what you need. Never commit .env.

### Model provider (set at least one) ###
# The matching elizaOS plugin loads only when its key is set (see src/character.ts).

# OpenAI, through @elizaos/plugin-openai. Also gives the agent embeddings for memory.
OPENAI_API_KEY=
# Optional model overrides. Plugin defaults: gpt-5-mini (large), gpt-5-nano (small).
# OPENAI_LARGE_MODEL=
# OPENAI_SMALL_MODEL=
# Optional: an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Anthropic, through @elizaos/plugin-anthropic. It takes text generation when set; it has no embeddings.
ANTHROPIC_API_KEY=
# The plugin's default models are old, so set them. Plugin 1.5.12 always sends a temperature,
# which the newest Claude models reject, so pick models that accept one.
ANTHROPIC_LARGE_MODEL=claude-sonnet-4-6
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5

### Dexra ###
# dxr_ key from https://dexra.dev/app/keys. Without it, paid checks answer 402 and every buy is blocked.
DEXRA_API_KEY=
# API origin. Point it at a local Dexra API for testing.
DEXRA_BASE_URL=https://api.dexra.dev
# Optional: also connect Dexra's remote MCP server (Streamable HTTP, sends DEXRA_API_KEY as a Bearer token).
# Buys and sells still go only through the guarded core.
DEXRA_MCP=false
DEXRA_MCP_URL=https://api.dexra.dev/mcp

### Trading core ###
# Needed for live trading. In a dry run it adds a Jupiter quote; without it, quoting is skipped.
JUPITER_API_KEY=
# Base58 64-byte secret key. Only for live trading. Use a dedicated wallet that holds little SOL.
SOLANA_PRIVATE_KEY=
# Live trading needs DRY_RUN=false AND SOLANA_PRIVATE_KEY AND JUPITER_API_KEY. Anything else is a dry run.
DRY_RUN=true
# Hard cap per buy, in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Jupiter slippage in basis points, a whole number from 0 to 1000.
SLIPPAGE_BPS=100
# When true, a caution verdict passes. avoid and unknown always block.
ALLOW_CAUTION=false

### elizaOS ###
# Port of the elizaOS server and web UI (default 3000).
# SERVER_PORT=3000
# Local database folder (PGlite). Set POSTGRES_URL to use Postgres instead.
# PGLITE_DATA_DIR=./.eliza/.elizadb
# POSTGRES_URL=
# Logging: fatal, error, warn, info, debug, trace.
# LOG_LEVEL=info
